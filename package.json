{
  "name": "miniscript2",
  "displayName": "MiniScript 2",
  "description": "MiniScript 2 language support for Visual Studio Code: syntax highlighting, a run button, notebooks, and the test suite in the Testing panel.",
  "version": "0.19.0",
  "publisher": "micro-expert",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/treytomes/vscode-miniscript-2.git"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onNotebookSerializer:miniscript-notebook"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "miniscript",
    "miniscript 2",
    "ms"
  ],
  "contributes": {
    "languages": [
      {
        "id": "miniscript",
        "aliases": [
          "MiniScript",
          "MiniScript 2",
          "miniscript"
        ],
        "extensions": [
          ".ms"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "miniscript",
        "scopeName": "source.miniscript",
        "path": "./syntaxes/miniscript.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "intrinsic",
        "superType": "function",
        "description": "A name the MiniScript language provides rather than the file, such as print or s.upper."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "miniscript",
        "scopes": {
          "intrinsic": [
            "support.function.builtin.miniscript"
          ]
        }
      }
    ],
    "notebooks": [
      {
        "type": "miniscript-notebook",
        "displayName": "MiniScript Notebook",
        "selector": [
          {
            "filenamePattern": "*.msnb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "miniscript2.runFile",
        "title": "Run MiniScript File",
        "icon": "$(play)"
      },
      {
        "command": "miniscript2.runFileWithArguments",
        "title": "Run MiniScript File with Arguments"
      },
      {
        "command": "miniscript2.runSelection",
        "title": "Run MiniScript Selection"
      },
      {
        "command": "miniscript2.startRepl",
        "title": "MiniScript REPL"
      },
      {
        "command": "miniscript2.newNotebook",
        "title": "New MiniScript Notebook",
        "icon": "$(notebook)"
      },
      {
        "command": "miniscript2.restartNotebook",
        "title": "Restart MiniScript Session",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "miniscript2.runFile",
          "when": "resourceLangId == miniscript",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "miniscript2.runSelection",
          "when": "editorHasSelection && resourceLangId == miniscript",
          "group": "navigation@2"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "miniscript2.restartNotebook",
          "when": "notebookType == miniscript-notebook",
          "group": "navigation@1"
        }
      ]
    },
    "configurationDefaults": {
      "[miniscript]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "MiniScript 2",
      "properties": {
        "miniscript2.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the MiniScript interpreter. Leave empty to use MINISCRIPT_EXE_PATH from the project's .env, then \"miniscript\" on PATH."
        },
        "miniscript2.testSuite": {
          "type": "string",
          "default": "test/run.ms",
          "description": "The suite the Testing panel runs, relative to the workspace folder. Its harness must take --json, --filter and --file, as test/harness.ms does."
        }
      }
    }
  }
}
