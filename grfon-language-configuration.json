{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["{", "}"]
  ],
  "wordPattern": "[^\\s;:{}]+",
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
